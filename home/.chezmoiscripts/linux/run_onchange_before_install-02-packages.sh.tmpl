{{ if eq .osid "linux-debian" "linux-raspbian" "linux-ubuntu" -}}

{{ $packages := list
     "build-essential"
     "curl"
     "file"
     "git"
     "git-lfs"
     "imagemagick"
     "libfuse2"
     "luarocks"
     "openssh-server"
     "poppler-utils"
     "python3-pip"
     "python3-venv"
     "tmux"
     "units"
     "zsh" -}}
{{ $snaps := list -}}
{{ $classicSnaps := list -}}

{{ if eq .osid "linux-ubuntu" -}}
{{   $packages = mustAppend $packages "btop" -}}
{{ end -}}

{{ if not .headless -}}
{{   $packages = mustAppend $packages "xclip" -}}
{{ end -}}

{{ if .personal -}}
{{   $packages = mustAppend $packages "musl-tools" -}}
{{   $classicSnaps = concat $classicSnaps (list "goreleaser" "snapcraft") -}}
{{ end -}}

{{ $sudo := "sudo " -}}
{{ if eq .chezmoi.username "root" -}}
{{   $sudo = "" -}}
{{ end -}}

#!/bin/bash

set -eufo pipefail

# Define color codes
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Spinner function
spinner() {
    local pid=$1
    local delay=0.1
    local spinstr='|/-\'
    echo -ne "${GREEN}"
    while ps -p $pid > /dev/null; do
        local temp=${spinstr#?}
        printf " [%c]  " "$spinstr"
        local spinstr=$temp${spinstr%"$temp"}
        sleep $delay
        printf "\b\b\b\b\b\b\b"
    done
    echo -ne "${NC}"
}

# Install packages with minimal output
echo -e "Pulling packages included in default repositories via package manager:"
echo -e "Updating package manager..."
log=$(mktemp)
# Run apt in the background with a spinner, but surface its output and exit code on failure
run_quiet() {
    "$@" > "$log" 2>&1 & local pid=$!
    spinner $pid
    if ! wait $pid; then
        echo "Command failed: $*" >&2
        cat "$log" >&2
        exit 1
    fi
}
run_quiet {{ $sudo }}apt-get update
echo -e "Installing packages..."
run_quiet {{ $sudo }}apt-get install -y {{ $packages | join " " }}
rm -f "$log"

{{ if lookPath "snap" }}
{{   range $snaps }}
echo -e "Checking and installing snap package: {{ . }}..."
( snap info {{ . }} | grep -q ^installed: ) || {{ $sudo }}snap install {{ . }}
{{   end }}
{{   range $classicSnaps }}
echo -e "Checking and installing classic snap package: {{ . }}..."
( snap info {{ . }} | grep -q ^installed: ) || {{ $sudo }}snap install --classic {{ . }}
{{   end }}
{{ end }}

echo -e "${GREEN}Packages installed successfully.${NC}"

{{ end -}}
