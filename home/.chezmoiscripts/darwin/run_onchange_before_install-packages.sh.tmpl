#!/bin/bash

set -eufo pipefail

# Homebrew may have just been installed, so it might not be on PATH yet.
if [[ -x /opt/homebrew/bin/brew ]]; then
	eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
	eval "$(/usr/local/bin/brew shellenv)"
fi

{{ $brews := list
     "btop"
     "curl"
     "dockutil"
     "ffmpeg"
     "imagemagick"
     "pam-reattach"
     "poppler" -}}
{{/* mise/aqua has no darwin/amd64 build of these; Apple Silicon gets them from mise */}}
{{ if ne .chezmoi.arch "arm64" -}}
{{   $brews = concat $brews (list "age" "gh") -}}
{{ end -}}
{{ $casks := list
     "1password-cli"
     "karabiner-elements"
     "tailscale-app" -}}

brew bundle --no-upgrade --file=/dev/stdin <<EOF
{{ range ($brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end -}}
EOF
