#!/bin/bash

set -eufo pipefail

{{ $brews := list
     "age"
     "btop"
     "curl"
     "dockutil"
     "ffmpeg"
     "git"
     "git-lfs"
     "wget"
     "xz" -}}
{{ $casks := list
     "1password-cli"
     "balenaetcher"
     "battery"
     "karabiner-elements"
     "microsoft-remote-desktop"
     "tailscale"
     "vlc" -}}

brew bundle --file=/dev/stdin <<EOF
{{ range ($brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end -}}
EOF
