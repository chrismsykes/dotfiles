#!/bin/bash

set -eufo pipefail

{{ $brews := list
     "curl"
     "dockutil" -}}
{{ $casks := list
     "1password-cli"
     "battery"
     "karabiner-elements"
     "tailscale" -}}

brew bundle --file=/dev/stdin <<EOF
{{ range ($brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end -}}
EOF
