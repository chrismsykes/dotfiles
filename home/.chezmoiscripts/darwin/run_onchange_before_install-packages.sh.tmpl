#!/bin/bash

set -eufo pipefail

{{ $brews := list
     "age"
     "btop"
     "curl"
     "dockutil"
     "ffmpeg"
     "gh" -}}
{{ $casks := list
     "1password-cli"
     "karabiner-elements"
     "tailscale" -}}

brew bundle --file=/dev/stdin <<EOF
{{ range ($brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end -}}
EOF
