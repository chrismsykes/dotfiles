#!/bin/bash

# Runs after files are applied so ~/.config/mise/config.toml exists on first run.
# mise config hash: {{ include "private_dot_config/mise/config.toml.tmpl" | sha256sum }}

set -eufo pipefail

# Install mise if not present
if ! command -v mise &> /dev/null; then
    echo "Installing mise..."
    curl https://mise.run | sh
fi

# Ensure mise is in PATH for this script
export PATH="$HOME/.local/bin:$PATH"

# Install tools defined in mise config
echo "Installing mise tools..."
mise install --yes
