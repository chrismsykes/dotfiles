[tools]
# Runtimes
go = "latest"
node = "lts"
java = "temurin-21"

# CLI tools
atuin = "latest"
fzf = "latest"
git-lfs = "latest"
{{- if eq .chezmoi.os "linux" }}
# Linux-only (mise/aqua has issues on macOS Intel for these)
age = "latest"
btop = "latest"
ffmpeg = "latest"
gh = "latest"
{{- end }}
lazygit = "latest"
zoxide = "latest"
bat = "latest"
eza = "latest"
fd = "latest"
ripgrep = "latest"
jq = "latest"
shellcheck = "latest"
gdu = "latest"
neovim = "latest"

# Yazi file manager + preview companions
# (fd, ripgrep, fzf, zoxide, jq, ffmpeg above are also used by yazi)
yazi = "latest"
"aqua:ip7z/7zip" = "latest"
resvg = "latest"
{{- if not .ephemeral }}
yt-dlp = "latest"
golangci-lint = "latest"
"cargo:bacon" = "latest"
{{- end }}

[settings]
experimental = true
