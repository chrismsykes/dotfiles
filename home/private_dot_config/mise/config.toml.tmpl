[tools]
# Runtimes
go = "latest"
node = "lts"
java = "temurin-21"

# CLI tools
atuin = "latest"
fzf = "latest"
git-lfs = "latest"
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.arch "arm64") }}
# No darwin/amd64 build in aqua; Intel Macs get these from brew
age = "latest"
gh = "latest"
{{- end }}
{{- if eq .chezmoi.os "linux" }}
# Linux-only in mise; macOS gets these from brew
btop = "latest"
ffmpeg = "latest"
{{- end }}
lazygit = "latest"
zoxide = "latest"
bat = "latest"
eza = "latest"
fd = "latest"
ripgrep = "latest"
jq = "latest"
yq = "latest"
just = "latest"
delta = "latest"
watchexec = "latest"
uv = "latest"
shellcheck = "latest"
gdu = "latest"
neovim = "latest"

# Yazi file manager + preview companions
# (fd, ripgrep, fzf, zoxide, jq, ffmpeg above are also used by yazi)
yazi = "latest"
"aqua:ip7z/7zip" = "latest"
resvg = "latest"
{{- if not .ephemeral }}
yt-dlp = "latest"
golangci-lint = "latest"
# cargo: backend needs a Rust toolchain; mise installs it before cargo tools
rust = "latest"
"cargo:bacon" = "latest"
{{- end }}

[settings]
experimental = true
